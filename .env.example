# Copy this file to .env and fill in real values before running `voice-agent serve`.
# `voice-agent demo` and `voice-agent eval` need none of this and run fully offline.

# --- OpenAI Realtime -------------------------------------------------------

# Secret API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Project ID from platform.openai.com/settings/organization/projects.
# This is also the SIP username: calls are routed to
# sip:<OPENAI_PROJECT_ID>@sip.api.openai.com;transport=tls
OPENAI_PROJECT_ID=

# Shared secret configured on the OpenAI webhook (platform.openai.com/settings ->
# Webhooks). Used to verify that incoming realtime.call.incoming events are
# genuinely from OpenAI. Leave blank only for local testing.
OPENAI_WEBHOOK_SECRET=

# Realtime model used to accept inbound calls and place outbound calls.
REALTIME_MODEL=gpt-realtime

# Voice used for the session. See the Realtime API docs for the current list.
REALTIME_VOICE=alloy

# --- Twilio Elastic SIP Trunking -------------------------------------------

# Account SID and Auth Token from the Twilio console. Only needed to place
# outbound calls (`voice-agent call`); inbound calls arrive at OpenAI directly
# once the trunk's origination URI points at sip.api.openai.com.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# A Twilio number on the trunk used as the caller ID for outbound calls.
TWILIO_FROM_NUMBER=

# --- Server ------------------------------------------------------------

# Port the webhook server listens on for `voice-agent serve`.
PORT=8000

# Public URL OpenAI can reach for the webhook, e.g. an ngrok tunnel
# (https://<subdomain>.ngrok.io/webhook/openai-realtime). Only used in
# documentation/logging; the actual webhook URL is configured on
# platform.openai.com, not read from this file.
PUBLIC_BASE_URL=
